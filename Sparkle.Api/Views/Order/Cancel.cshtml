@model Sparkle.Domain.Orders.Order
@{
    ViewData["Title"] = "Cancel Order";
    var cancelReturnUrl = Context.Request.Headers["Referer"].ToString();
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-sm overflow-hidden" style="border-radius: 20px;">
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger" style="width: 80px; height: 80px; border-radius: 50%;">
                            <i class="bi bi-exclamation-triangle" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                    
                    <h2 class="fw-bold mb-2">Cancel Order?</h2>
                    <p class="text-muted mb-4">Are you sure you want to cancel order <strong>#@Model.OrderNumber</strong>? This action will restock the items and cancel the fulfillment process.</p>
                    
                    <form asp-controller="Order" asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="text-start">
                        <input type="hidden" name="returnUrl" value="@cancelReturnUrl" />
                        
                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase text-muted">Reason for cancellation (optional)</label>
                            <textarea name="reason" class="form-control bg-light border-0" rows="3" placeholder="Please tell us why..." style="border-radius: 12px; resize: none;"></textarea>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger py-3 fw-bold" style="border-radius: 12px; box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);">
                                Yes, Cancel My Order
                            </button>
                            <a href="@(string.IsNullOrEmpty(cancelReturnUrl) ? "/account-info/orders" : cancelReturnUrl)" class="btn btn-link text-decoration-none text-muted py-2">
                                No, Keep My Order
                            </a>
                        </div>
                    </form>
                </div>
            </div>
            
            <div class="text-center mt-4">
                <p class="small text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Once cancelled, this action cannot be undone easily.
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    body { background-color: #f8f9fa; }
    .btn-danger:hover { background-color: #bb2d3b; transform: translateY(-1px); transition: all 0.2s; }
</style>
