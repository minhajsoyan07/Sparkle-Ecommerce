@model Sparkle.Api.Controllers.CategoryController.CategoryViewModel
@{
    var isBangla = Context.Request.Cookies["sparkle-lang"] == "bn";
    ViewData["Title"] = Model.Category.Name;
}

<style>
    .category-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: white;
        border: 1px solid #e8edf2;
        border-radius: 10px;
        padding: 0.75rem 1.1rem;
        margin-bottom: 1.5rem;
    }

    .category-bar h1 {
        font-size: 0.95rem !important;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .category-bar .count {
        font-size: 0.82rem;
        color: #94a3b8;
        margin-top: 2px;
    }

    .sort-select {
        border: 1px solid #e2e8f0;
        padding: 0.4rem 0.65rem;
        border-radius: 6px;
        font-size: 0.82rem;
        background: white;
        color: #334155;
        cursor: pointer;
        outline: none;
    }

    .sort-select:focus {
        border-color: #f97316;
        box-shadow: 0 0 0 2px rgba(249, 115, 22, 0.1);
    }

    .product-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 10px 24px rgba(0,0,0,0.11);
    }

    .product-image-wrapper {
        position: relative;
        width: 100%;
        height: 200px;
        overflow: hidden;
        background: #f9fafb;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .product-card:hover .product-image { transform: scale(1.06); }

    .product-discount-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #dc2626;
        color: white;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .product-info { padding: 1rem; }

    .product-title {
        font-size: 0.88rem;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 0.5rem;
        height: 2.6rem;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .product-price {
        font-size: 1.1rem;
        font-weight: 700;
        color: #dc2626;
    }

    .product-original-price {
        text-decoration: line-through;
        color: #9ca3af;
        font-size: 0.82rem;
        margin-left: 0.4rem;
    }

    .product-rating {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.5rem;
        font-size: 0.8rem;
        color: #6b7280;
    }

    .product-rating .stars { color: #f59e0b; }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: white;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .empty-state i { font-size: 3.5rem; color: #d1d5db; margin-bottom: 1rem; }
    .empty-state h3 { font-size: 1.2rem; font-weight: 700; color: #374151; }
    .empty-state p { color: #6b7280; font-size: 0.9rem; margin-bottom: 1.5rem; }

    .pagination { gap: 0.35rem; }

    .pagination .page-link {
        border-radius: 7px;
        border: 1px solid #e5e7eb;
        color: #4b5563;
        font-size: 0.88rem;
        padding: 0.5rem 0.85rem;
        transition: all 0.2s;
    }

    .pagination .page-item.active .page-link {
        background: #f97316;
        border-color: #f97316;
        color: white;
    }
</style>

<div class="container mb-5 mt-4">

    <div class="category-bar">
        <div>
            <h1>@Model.Category.Name</h1>
            <div class="count">@Model.Products.Count @(isBangla ? "টি পণ্য" : "products")</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span style="font-size:0.82rem;color:#94a3b8;">@(isBangla ? "সাজান:" : "Sort by:")</span>
            <select class="sort-select" onchange="window.location.href='/category/@Model.Category.Slug?sort='+this.value+'&page=@Model.CurrentPage'">
                <option value="">@(isBangla ? "নতুন প্রথমে" : "Newest first")</option>
                <option value="price-asc"  selected="@(Model.CurrentSort == "price-asc")">@(isBangla ? "মূল্য: কম থেকে বেশি" : "Price: Low to High")</option>
                <option value="price-desc" selected="@(Model.CurrentSort == "price-desc")">@(isBangla ? "মূল্য: বেশি থেকে কম" : "Price: High to Low")</option>
                <option value="name"       selected="@(Model.CurrentSort == "name")">@(isBangla ? "নাম অনুসারে" : "Name (A-Z)")</option>
            </select>
        </div>
    </div>

    @if (!Model.Products.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h3>@(isBangla ? "এই বিভাগে কোনো পণ্য নেই" : "No products in this category")</h3>
            <p>@(isBangla ? "শীঘ্রই নতুন পণ্য যুক্ত করা হবে!" : "New products will be added soon!")</p>
            <a href="/" class="btn btn-primary px-4">@(isBangla ? "হোমপেজে ফিরে যান" : "Back to Homepage")</a>
        </div>
    }
    else
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
            @foreach (var product in Model.Products)
            {
                var imageUrl = product.Images?.FirstOrDefault()?.Url ?? "https://via.placeholder.com/300x300?text=No+Image";
                <div class="col">
                    <partial name="_ProductCard" model="@(new {
                        Id = product.Id,
                        Title = product.Title,
                        ImageUrl = imageUrl,
                        Price = product.Price,
                        BasePrice = product.BasePrice,
                        DiscountPercent = product.DiscountPercent ?? 0,
                        Stock = (int?)null,
                        Rating = product.AverageRating,
                        Reviews = product.TotalReviews,
                        IsFreeShipping = true,
                        ConfidenceScore = 0
                    })" />
                </div>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="/category/@Model.Category.Slug?page=@(Model.CurrentPage - 1)&sort=@Model.CurrentSort">
                                @(isBangla ? "পূর্ববর্তী" : "Previous")
                            </a>
                        </li>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="/category/@Model.Category.Slug?page=@i&sort=@Model.CurrentSort">@i</a>
                        </li>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="/category/@Model.Category.Slug?page=@(Model.CurrentPage + 1)&sort=@Model.CurrentSort">
                                @(isBangla ? "পরবর্তী" : "Next")
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
