@{
    ViewData["Title"] = "Reports & Analytics";
}

<div class="mb-4">
    <h4 class="mb-1 fw-bold" style="font-size: 24px; color: #111827;">Reports & Analytics</h4>
    <p class="text-muted mb-0" style="font-size: 14px;">Comprehensive business intelligence and data exports</p>
</div>

<style>
    :root {
        --slate-50: #f8fafc;
        --slate-100: #f1f5f9;
        --slate-200: #e2e8f0;
        --slate-500: #64748b;
        --slate-900: #0f172a;
    }

    .report-card {
        background: white;
        border-radius: 12px;
        border: 1px solid var(--slate-200);
        padding: 1.5rem;
        height: 100%;
        transition: all 0.2s ease;
    }

    .report-card:hover {
        border-color: #6366f1;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.05);
    }

    .icon-box {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.25rem;
    }

    .icon-box i {
        font-size: 1.1rem;
    }

    .report-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--slate-900);
        margin-bottom: 0.5rem;
    }

    .report-desc {
        font-size: 0.8rem;
        color: var(--slate-500);
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }

    .btn-action {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.025em;
        padding: 0.6rem 1rem;
        border-radius: 6px;
        width: 100%;
    }

    .form-label-custom {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--slate-500);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control-custom {
        font-size: 0.85rem;
        border-radius: 8px;
        border: 1px solid var(--slate-200);
        padding: 0.5rem 0.75rem;
    }
</style>

<div class="mb-4">
    <h4 class="fw-bold mb-1" style="font-size: 24px; color: var(--slate-900);">Reports & Analytics</h4>
    <p class="text-muted mb-0" style="font-size: 14px;">Analyze platform performance and export critical business data.</p>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="report-card">
            <div class="icon-box" style="background: #f0fdf4; color: #15803d;">
                <i class="bi bi-graph-up"></i>
            </div>
            <h5 class="report-title">Sales Analytics</h5>
            <p class="report-desc">Track revenue growth, order volume, and sales trends across periods.</p>
            <a href="/Admin/Reports/Sales" class="btn btn-success btn-action">View Sales</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="report-card">
            <div class="icon-box" style="background: #eff6ff; color: #1d4ed8;">
                <i class="bi bi-people"></i>
            </div>
            <h5 class="report-title">User Insights</h5>
            <p class="report-desc">Analyze user demographics, growth rates, and engagement metrics.</p>
            <a href="/Admin/Reports/Users" class="btn btn-primary btn-action">View Users</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="report-card">
            <div class="icon-box" style="background: #fffbeb; color: #b45309;">
                <i class="bi bi-shop"></i>
            </div>
            <h5 class="report-title">Seller Performance</h5>
            <p class="report-desc">Monitor seller ratings, product quality, and individual shop performance.</p>
            <a href="/Admin/Reports/Sellers" class="btn btn-warning btn-action">View Sellers</a>
        </div>
    </div>
</div>

<div class="report-card mt-4">
    <h6 class="report-title mb-4">Quick Data Export</h6>
    <form action="/Admin/Reports/Export" method="get" class="row g-3">
        <div class="col-md-3">
            <label class="form-label-custom">Report Type</label>
            <select name="type" class="form-select form-control-custom">
                <option value="sales">Sales Summary</option>
                <option value="users">User Database</option>
                <option value="sellers">Seller Registry</option>
                <option value="products">Inventory Report</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label-custom">Format</label>
            <select name="format" class="form-select form-control-custom">
                <option value="csv">Excel (CSV)</option>
                <option value="pdf">Document (PDF)</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label-custom">From Date</label>
            <input type="date" name="from" class="form-control form-control-custom" value="@DateTime.Now.AddMonths(-1).ToString("yyyy-MM-dd")">
        </div>
        <div class="col-md-3">
            <label class="form-label-custom">To Date</label>
            <input type="date" name="to" class="form-control form-control-custom" value="@DateTime.Now.ToString("yyyy-MM-dd")">
        </div>
        <div class="col-md-1 d-flex align-items-end">
            <button type="submit" class="btn btn-dark btn-action" style="height: 38px; width: 100%;">
                <i class="bi bi-download"></i>
            </button>
        </div>
    </form>
</div>
