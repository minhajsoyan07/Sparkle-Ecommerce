<style>
    :root {
        --slate-50: #f8fafc;
        --slate-100: #f1f5f9;
        --slate-200: #e2e8f0;
        --slate-500: #64748b;
        --slate-900: #0f172a;
    }

    .report-header {
        margin-bottom: 2rem;
    }

    .report-stat-card {
        background: white;
        border-radius: 12px;
        border: 1px solid var(--slate-200);
        padding: 1.25rem;
    }

    .stat-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--slate-500);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }

    .stat-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--slate-900);
    }

    .filter-card {
        background: white;
        border-radius: 12px;
        border: 1px solid var(--slate-200);
        padding: 1.25rem;
        margin-bottom: 2rem;
    }

    .table-card {
        background: white;
        border-radius: 12px;
        border: 1px solid var(--slate-200);
        overflow: hidden;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
    }

    .report-table th {
        background: var(--slate-50);
        padding: 1rem;
        text-align: left;
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--slate-500);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--slate-200);
    }

    .report-table td {
        padding: 1rem;
        border-bottom: 1px solid var(--slate-100);
        font-size: 0.85rem;
        color: var(--slate-800);
    }

    .btn-minimal {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        transition: all 0.2s;
    }
</style>

<div class="report-header d-flex justify-content-between align-items-center">
    <div>
        <h4 class="fw-bold mb-1" style="font-size: 24px; color: var(--slate-900);">Sales Analytics</h4>
        <p class="text-muted mb-0" style="font-size: 14px;">Detailed revenue breakdown and performance metrics.</p>
    </div>
    <a href="/Admin/Reports" class="btn btn-outline-secondary btn-minimal">
        <i class="bi bi-arrow-left me-1"></i> Dashboard
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="report-stat-card">
            <div class="stat-label">Total Revenue</div>
            <div class="stat-value text-success">৳@((decimal)ViewBag.TotalRevenue).ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="report-stat-card">
            <div class="stat-label">Total Orders</div>
            <div class="stat-value text-primary">@((int)ViewBag.TotalOrders)</div>
        </div>
    </div>
</div>

<div class="filter-card">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="stat-label">Date Range</label>
            <div class="d-flex gap-2">
                <input type="date" name="from" class="form-control form-control-sm" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" style="border-radius: 8px;">
                <input type="date" name="to" class="form-control form-control-sm" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" style="border-radius: 8px;">
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-dark btn-minimal flex-grow-1">
                <i class="bi bi-filter me-1"></i> Apply Filter
            </button>
            <div class="dropdown">
                <button class="btn btn-outline-dark btn-minimal dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-download me-1"></i> Export
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                    <li><a class="dropdown-item py-2 small fw-bold" href="/Admin/Reports/Export?type=sales&from=@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))&to=@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))&format=csv">CSV Export</a></li>
                    <li><a class="dropdown-item py-2 small fw-bold" href="/Admin/Reports/Export?type=sales&from=@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))&to=@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))&format=pdf" target="_blank">PDF Report</a></li>
                </ul>
            </div>
        </div>
    </form>
</div>

<div class="table-card">
    <table class="report-table">
        <thead>
            <tr>
                <th style="padding-left: 1.5rem;">Date</th>
                <th>Orders</th>
                <th>Revenue</th>
                <th style="padding-right: 1.5rem;" class="text-end">Avg. Ticket</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="padding-left: 1.5rem;" class="fw-bold">@item.Date.ToString("MMM dd, yyyy")</td>
                    <td class="text-muted">@item.TotalOrders orders</td>
                    <td class="fw-bold text-dark">৳@item.TotalRevenue.ToString("N0")</td>
                    <td style="padding-right: 1.5rem;" class="text-end text-muted small">৳@item.AverageOrderValue.ToString("N0")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
