@model Sparkle.Domain.Catalog.Category
@{
    ViewData["Title"] = "Edit Category";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-header">
    <div>
        <h2 class="content-title">Edit Category</h2>
        <p class="text-muted">Update category details.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i> Back to List
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="content-card">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label control-label">Category Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Slug" class="form-label control-label">Slug</label>
                    <input asp-for="Slug" class="form-control" />
                    <div class="form-text">URL-friendly name. Changing this may affect existing links.</div>
                    <span asp-validation-for="Slug" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Icon" class="form-label control-label">Icon Class</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-star"></i></span>
                            <input asp-for="Icon" class="form-control" />
                        </div>
                        <span asp-validation-for="Icon" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DisplayOrder" class="form-label control-label">Display Order</label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" />
                        <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label control-label">Category Image</label>
                    <div class="mb-2" style="background-color: #f5f5f5; border-radius: 8px; padding: 15px; text-align: center; min-height: 150px; display: flex; align-items: center; justify-content: center; position: relative;">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div id="currentImageContainer" style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
                                <img id="currentImage" src="@Model.ImageUrl" alt="@Model.Name" class="img-thumbnail" style="max-width: 200px; max-height: 200px; object-fit: contain;" />
                                <small class="text-muted">Current Image</small>
                                <button type="button" class="btn btn-sm btn-danger" onclick="removeCurrentImage()">Remove Image</button>
                            </div>
                            <div id="noImageContainer" style="display: none; text-align: center; color: #999;">
                                <i class="bi @(!string.IsNullOrEmpty(Model.Icon) ? Model.Icon : "bi-folder")" style="font-size: 3rem; display: block; margin-bottom: 10px; opacity: 0.5;"></i>
                                <p style="margin: 0;">No image uploaded yet</p>
                            </div>
                        }
                        else
                        {
                            <div id="noImageContainer" style="text-align: center; color: #999;">
                                <i class="bi @(!string.IsNullOrEmpty(Model.Icon) ? Model.Icon : "bi-folder")" style="font-size: 3rem; display: block; margin-bottom: 10px; opacity: 0.5;"></i>
                                <p style="margin: 0;">No image uploaded yet</p>
                            </div>
                        }
                        <div id="previewContainer" style="display: none; flex-direction: column; align-items: center; gap: 10px;">
                            <img id="previewImage" style="max-width: 200px; max-height: 200px; object-fit: contain;" />
                            <small class="text-muted">Image Preview</small>
                        </div>
                    </div>
                    <input type="file" name="ImageFile" class="form-control" accept="image/*" id="imageUpload" onchange="previewImage(event)" />
                    <div class="form-text">
                        <strong>Upload a new image</strong> to replace the current one. 
                        <br />Recommended size: 400x400px (square images work best for category cards)
                        <br />Supported formats: PNG, JPG, WebP (Max 5MB)
                    </div>
                    <input type="hidden" asp-for="ImageUrl" />
                    <input type="hidden" id="RemoveImage" name="RemoveImage" value="false" />
                </div>

                <div class="d-flex justify-content-between mt-4 border-top pt-3">
                     <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                        <i class="bi bi-trash me-2"></i> Delete
                    </button>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
             <form id="deleteForm" asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:none;"></form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function confirmDelete() {
            if(confirm('Are you sure you want to delete this category?')) {
                document.getElementById('deleteForm').submit();
            }
        }

        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    // Hide current image, show preview
                    const currentContainer = document.getElementById('currentImageContainer');
                    const noImageContainer = document.getElementById('noImageContainer');
                    const previewContainer = document.getElementById('previewContainer');
                    
                    if (currentContainer) currentContainer.style.display = 'none';
                    if (noImageContainer) noImageContainer.style.display = 'none';
                    
                    const previewImage = document.getElementById('previewImage');
                    previewImage.src = e.target.result;
                    previewContainer.style.display = 'flex';
                    
                    // User uploaded a new image, so we don't want to just remove it
                    document.getElementById('RemoveImage').value = 'false';
                };
                reader.readAsDataURL(file);
            }
        }

        function updateIconPreview() {
            const iconInput = document.getElementById('Icon');
            const noImageContainer = document.getElementById('noImageContainer');
            if (iconInput && noImageContainer) {
                const iconElement = noImageContainer.querySelector('i');
                if (iconElement) {
                    const currentIconClass = iconInput.value.trim() || 'bi-folder';
                    // Remove existing bi-* classes
                    iconElement.className = iconElement.className.replace(/\bbi-\S+/g, '');
                    // Add the new class
                    iconElement.classList.add('bi');
                    iconElement.classList.add(currentIconClass);
                }
            }
        }

        function removeCurrentImage() {
            document.getElementById('imageUpload').value = '';
            
            // Set explicit flag for backend to remove the image
            document.getElementById('RemoveImage').value = 'true';
            
            const imgInput = document.querySelector('input[name="ImageUrl"]');
            if (imgInput) imgInput.value = ''; // Clear hidden input so backend knows to delete it
            
            const currentContainer = document.getElementById('currentImageContainer');
            const noImageContainer = document.getElementById('noImageContainer');
            const previewContainer = document.getElementById('previewContainer');
            
            if (currentContainer) currentContainer.style.display = 'none';
            if (previewContainer) previewContainer.style.display = 'none';
            if (noImageContainer) {
                updateIconPreview();
                noImageContainer.style.display = 'block';
            }
        }

        // Add event listener for real-time icon updates
        document.addEventListener('DOMContentLoaded', function() {
            const iconInput = document.getElementById('Icon');
            if (iconInput) {
                iconInput.addEventListener('input', updateIconPreview);
            }
        });
    </script>
}

