@model IEnumerable<Sparkle.Api.Areas.Profile.Controllers.InvoicesController.InvoiceListItem>
@{
    ViewData["Title"] = "My Invoices";
    var lang = Context.Request.Cookies["sparkle-lang"] == "bn" ? "bn" : "en";
    var isBangla = lang == "bn";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-3">
            @await Html.PartialAsync("_ProfileLayout")
        </div>
        <div class="col-md-9">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>@(isBangla ? "আমার চালান" : "My Invoices")</h5>
                </div>
                <div class="card-body">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-receipt text-muted" style="font-size: 4rem;"></i>
                            <p class="text-muted mt-3">@(isBangla ? "কোনো চালান পাওয়া যায়নি" : "No invoices found")</p>
                            <a href="/orders" class="btn btn-primary">@(isBangla ? "অর্ডার দেখুন" : "View Orders")</a>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>@(isBangla ? "চালান নং" : "Invoice #")</th>
                                        <th>@(isBangla ? "তারিখ" : "Date")</th>
                                        <th>@(isBangla ? "অর্ডার" : "Order")</th>
                                        <th>@(isBangla ? "পরিমাণ" : "Amount")</th>
                                        <th>@(isBangla ? "অ্যাকশন" : "Action")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in Model)
                                    {
                                        <tr>
                                            <td>#@invoice.InvoiceNumber</td>
                                            <td>@invoice.InvoiceDate.ToString("dd MMM yyyy")</td>
                                            <td>#@invoice.OrderId</td>
                                            <td>৳@invoice.TotalAmount.ToString("N2")</td>
                                            <td>
                                                <a href="/profile/invoices/view/@invoice.OrderId" class="btn btn-sm btn-outline-primary" target="_blank">
                                                    <i class="bi bi-eye"></i> @(isBangla ? "দেখুন" : "View")
                                                </a>
                                                <a href="/profile/invoices/download/@invoice.OrderId" class="btn btn-sm btn-outline-success">
                                                    <i class="bi bi-download"></i> PDF
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>